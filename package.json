{
  "name": "rate-coffee",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev -w @rate-coffee/web",
    "build": "npm run build -w @rate-coffee/web",
