# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ingestion scripts only (npm run ingest:*). Never set these on Vercel.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=

# Show "Continue with Google" on /login. Only set it once the Google provider is enabled in the
# Supabase dashboard (Authentication -> Sign In / Providers -> Google) with a Google OAuth client.
# NEXT_PUBLIC_AUTH_GOOGLE=1

